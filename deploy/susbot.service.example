[Unit]
Description=Backend SusPredict
After=network.target ollama.service
Wants=ollama.service

[Service]
Type=simple
User=bieelx
WorkingDirectory=/home/bieelx/suspredict
EnvironmentFile=/home/bieelx/suspredict/.env
ExecStart=/home/bieelx/suspredict/venv/bin/python -m uvicorn api.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
