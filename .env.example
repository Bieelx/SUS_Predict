# Supabase Auth (valores publicos do painel: Project URL e Publishable key)
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_substitua_aqui

# Nunca exponha esta chave ao frontend. Use somente quando um servico de
# backend realmente precisar ignorar RLS.
SUPABASE_SECRET_KEY=

# Login local sem Supabase. Mantenha false fora do desenvolvimento.
SUS_PREDICT_DEV_AUTH=false
SUSBOT_DEV_AUTH_SECRET=troque-por-um-segredo-local-longo

# Provedor local da Clara (Ollama escutando somente em localhost)
SUSBOT_LLM_PROVIDER=local
SUSBOT_LOCAL_BASE_URL=http://127.0.0.1:11434/v1
SUSBOT_LOCAL_MODEL=susbot-3b
SUSBOT_LOCAL_API_KEY=
SUSBOT_LOCAL_TIMEOUT_SECONDS=90

# Transcrição local de áudios recebidos nos canais
CLARA_STT_PROVIDER=local
CLARA_STT_MODEL=small
CLARA_STT_DEVICE=cpu
CLARA_STT_COMPUTE_TYPE=int8
# true impede download automático do modelo; use depois de armazená-lo no servidor.
CLARA_STT_LOCAL_FILES_ONLY=false
CLARA_AUDIO_MAX_SECONDS=120
CLARA_AUDIO_MAX_BYTES=10485760

# Uma chave diferente por integrante/banca, separadas por virgula.
# Gere cada valor com: python3.12 -c "import secrets; print(secrets.token_urlsafe(32))"
SUSBOT_API_KEYS=
SUSBOT_RATE_LIMIT_PER_MINUTE=10
SUSBOT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── WhatsApp via OpenWA (gateway não-oficial, roda em Docker no servidor Ubuntu)
# Setup: bash deploy/openwa.sh up   →   chave   →   sessao   →   qr   →   smoke
# Use um chip dedicado. Meta pode banir o número: não use o institucional.
OPENWA_DIR=/home/bieelx/openwa
OPENWA_BASE_URL=http://127.0.0.1:2785
OPENWA_SESSION_NAME=clara
OPENWA_ENGINE=baileys
# Gerada no primeiro boot do container; leia com: bash deploy/openwa.sh chave
OPENWA_API_KEY=
# Preenchido por: bash deploy/openwa.sh sessao
OPENWA_SESSION_ID=
# Mínimo 16 caracteres (exigência do OpenWA). Assina o HMAC do webhook.
# Gere com: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
OPENWA_WEBHOOK_SECRET=
# Número que recebe o pareamento, formato internacional só com dígitos (link wa.me).
WHATSAPP_NUMERO=
