# Supabase Auth (valores publicos do painel: Project URL e Publishable key)
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_substitua_aqui

# Nunca exponha esta chave ao frontend. Use somente quando um servico de
# backend realmente precisar ignorar RLS.
SUPABASE_SECRET_KEY=

# Login local sem Supabase. Mantenha false fora do desenvolvimento.
SUS_PREDICT_DEV_AUTH=false
SUSBOT_DEV_AUTH_SECRET=troque-por-um-segredo-local-longo

# Provedor local do SusBot (Ollama escutando somente em localhost)
SUSBOT_LLM_PROVIDER=local
SUSBOT_LOCAL_BASE_URL=http://127.0.0.1:11434/v1
SUSBOT_LOCAL_MODEL=susbot-3b
SUSBOT_LOCAL_API_KEY=
SUSBOT_LOCAL_TIMEOUT_SECONDS=90

# Uma chave diferente por integrante/banca, separadas por virgula.
# Gere cada valor com: python3.12 -c "import secrets; print(secrets.token_urlsafe(32))"
SUSBOT_API_KEYS=
SUSBOT_RATE_LIMIT_PER_MINUTE=10
SUSBOT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
