# Copie para .env e preencha com seus valores (NÃO comite .env).
#

APP_ENV=development
SUPABASE_BUCKET_RAW=datasus-raw
SUPABASE_RAW_MAX_BYTES=45000000

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax

FRONTEND_URL=http://localhost:3000
AUTH_REDIRECT_URL=http://localhost:3000/auth/update-password
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

SUS_PREDICT_DEV_AUTH=true


GEMINI_API_KEY=
# Tarefas leves usam a Clara/Ollama. ETP usa Gemini quando a chave estiver
# configurada; sem chave, a rota validada e a confirmação humana continuam locais.
SUSBOT_COMPLEX_LLM_PROVIDER=gemini
SUSBOT_COMPLEX_GEMINI_MODEL=gemini-2.5-flash
# Só é consultado quando o parser local não reconhece um relato operacional.
# O resultado ainda é validado e salvo apenas como rascunho para confirmação.
SUSBOT_GEMINI_INPUT_ENABLED=true
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

TELEGRAM_BOT_USERNAME=suspredictbot
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
CHANNEL_PAIRING_SECRET=
ENABLE_TELEGRAM_TUNNEL=true

# WhatsApp via OpenWA (gateway não oficial, pareado por QR — use chip dedicado).
# Passo a passo: bash deploy/openwa.sh (up → chave → sessao → qr → webhook).
WHATSAPP_BOT_NUMBER=
OPENWA_BASE_URL=http://127.0.0.1:2785
OPENWA_API_KEY=
OPENWA_SESSION_ID=
OPENWA_WEBHOOK_SECRET=

# Webhooks são persistidos no SQLite antes do HTTP 200 e retomados após restart.
CHANNEL_QUEUE_MAX_ATTEMPTS=5
CHANNEL_QUEUE_LEASE_SECONDS=300
CHANNEL_QUEUE_POLL_SECONDS=1

# Resposta de voz: o plano gratuito usa a franquia mensal da conta ElevenLabs.
# Só responde em áudio quando o usuário falou por áudio e a resposta é longa.
CLARA_TTS_ENABLED=true
CLARA_TTS_MIN_CHARS=320
CLARA_TTS_MAX_CHARS=2400
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_OUTPUT_FORMAT=mp3_22050_32


SUSBOT_LLM_PROVIDER=local
SUSBOT_LOCAL_BASE_URL=http://100.125.146.50:11434/v1
SUSBOT_LOCAL_MODEL=susbot-3b
SUSBOT_LOCAL_API_KEY=
SUSBOT_LOCAL_TIMEOUT_SECONDS=20

# Registros operacionais locais: ativar somente após migration e vínculos.
# Conexão PostgreSQL exclusiva do backend (direta ou pooler, com TLS).
CLARA_REGISTROS_LOCAIS_ENABLED=false
CLARA_REGISTROS_DATABASE_URL=

# Clara proativa: alerta crítico (severidade ALTA da Visão Geral) para quem enviou /alertas ligar no canal.
CLARA_ALERTAS_PROATIVOS=false
CLARA_ALERTAS_INTERVALO_MINUTOS=30
CLARA_ALERTAS_SILENCIO=22-7
