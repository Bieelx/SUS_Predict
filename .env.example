# Ambiente
APP_ENV=development
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Injetada pelo Vite no build do frontend (use a URL pública HTTPS em produção)
VITE_API_BASE=http://localhost:8000

# Supabase Auth e Data API
SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_SUBSTITUA
SUPABASE_SECRET_KEY=sb_secret_SUBSTITUA

# Cookies e links enviados por e-mail
AUTH_REDIRECT_URL=http://localhost:3000/auth/update-password
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax

# SusBot
GEMINI_API_KEY=SUBSTITUA
GROQ_API_KEY=SUBSTITUA
GROQ_MODEL=llama-3.3-70b-versatile
SUSBOT_MEMORY_KEY=
# SUSBOT_MEMORY_KEY_FILE=

# Integração opcional com Telegram
TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
CHANNEL_PAIRING_SECRET=
ENABLE_TELEGRAM_TUNNEL=true

# Persistência DATASUS
SUPABASE_BUCKET_RAW=datasus-raw
SUPABASE_ENABLE_RAW_UPLOAD=true
SUPABASE_RAW_MAX_BYTES=250000000
SUPABASE_ENABLE_CACHE_READ=true
# SQLITE_PATH=api/sus_predict.db

# Bypass estritamente local (desabilitado por padrão e sempre recusado em produção)
SUS_PREDICT_DEV_AUTH=
# SUS_PREDICT_DEV_PASSWORD=
# SUSBOT_DEV_AUTH_SECRET=
