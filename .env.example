# Copie para .env e preencha com seus valores (NÃO comite .env).
#

APP_ENV=development
SUPABASE_BUCKET_RAW=datasus-raw
SUPABASE_RAW_MAX_BYTES=45000000

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax

FRONTEND_URL=http://localhost:3000
AUTH_REDIRECT_URL=http://localhost:3000/auth/update-password
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

SUS_PREDICT_DEV_AUTH=true

# SUPABASE_ENABLE_RAW_UPLOAD=true
# Budget por arquivo bruto compactado (bytes). Ajuste para caber no plano free.
# Supabase
# SUPABASE_URL=
# Service Role Key (SEGREDO): use APENAS no backend.
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_ANON_KEY=

GEMINI_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

TELEGRAM_BOT_USERNAME=suspredictbot
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
CHANNEL_PAIRING_SECRET=
ENABLE_TELEGRAM_TUNNEL=true

# WhatsApp via OpenWA (gateway não oficial, pareado por QR — use chip dedicado).
# Passo a passo: bash deploy/openwa.sh (up → chave → sessao → qr → webhook).
WHATSAPP_BOT_NUMBER=
OPENWA_BASE_URL=http://127.0.0.1:2785
OPENWA_API_KEY=
OPENWA_SESSION_ID=
OPENWA_WEBHOOK_SECRET=


SUSBOT_LLM_PROVIDER=local
SUSBOT_LOCAL_BASE_URL=http://100.125.146.50:11434/v1
SUSBOT_LOCAL_MODEL=susbot-3b
SUSBOT_LOCAL_API_KEY=
SUSBOT_LOCAL_TIMEOUT_SECONDS=20
