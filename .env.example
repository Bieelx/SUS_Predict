# Ambiente
APP_ENV=development
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Supabase Auth e Data API
SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_SUBSTITUA
SUPABASE_SECRET_KEY=sb_secret_SUBSTITUA

# Cookies e links enviados por e-mail
AUTH_REDIRECT_URL=http://localhost:3000/auth/update-password
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax

# SusBot
GEMINI_API_KEY=SUBSTITUA

# Bypass estritamente local (desabilitado por padrão e sempre recusado em produção)
SUS_PREDICT_DEV_AUTH=
