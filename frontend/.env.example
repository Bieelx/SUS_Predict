# Desenvolvimento local conectado ao backend Ubuntu por Cloudflare Tunnel.
VITE_API_BASE=/backend
SUSBOT_PROXY_TARGET=https://seu-dominio-ou-tunel.trycloudflare.com

# Uma chave individual presente em SUSBOT_API_KEYS no servidor.
# Nao use o prefixo VITE_ para evitar incluir a chave no JavaScript do navegador.
SUSBOT_API_KEY=

# Alternativa para um frontend publicado: use a URL HTTPS definitiva.
# O backend precisara permitir a origem publica exata em SUSBOT_CORS_ORIGINS.
# VITE_API_BASE=https://api.seu-dominio.com
# VITE_SUSBOT_API_KEY=

# Área "Registros da unidade" com fixtures rotuladas como Demonstração.
# Só funciona com "npm run dev" (DEV) e exige o valor exato 1. Nunca use em producao.
# VITE_REGISTROS_LOCAIS_DEMO=1
